rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // the owner's Google account (admin page). Replace OWNER_EMAIL in the Firebase console; the real address is not committed here.
    function owner() { return request.auth != null && request.auth.token.email == 'OWNER_EMAIL'; }
    // each signed-in player reads and writes only their own save; the owner may read every save (admin page)
    match /saves/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || owner());
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // player market: anyone signed in can browse and buy, a listing must carry the seller's own id
    match /market/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.seller == request.auth.uid
        && request.resource.data.p is int
        && request.resource.data.p >= 100 && request.resource.data.p <= 5000000;
      allow delete: if request.auth != null;
    }
    // PvP arena: everyone signed in can read the teams, each player writes only their own entry
    match /arena/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.pts is int
        && request.resource.data.pts >= 0 && request.resource.data.pts <= 9999;
    }
    // sale proceeds waiting for the seller to collect
    match /payouts/{id} {
      allow create: if request.auth != null
        && request.resource.data.gold is int
        && request.resource.data.gold >= 0 && request.resource.data.gold <= 5000000;
      allow read, delete: if request.auth != null && resource.data.to == request.auth.uid;
    }
    // diamonds waiting for a player: created by the owner (or by the top-up Worker, which bypasses rules); the receiving player reads and deletes their own
    match /grants/{id} {
      allow create: if owner()
        && request.resource.data.dia is int
        && request.resource.data.dia > 0 && request.resource.data.dia <= 100000;
      allow read, delete: if request.auth != null && (resource.data.to == request.auth.uid || owner());
    }
    // players online: each signed-in player keeps one small note with the time it was last seen; anyone signed in may count them
    match /online/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // invite a friend: a new account writes one note naming its inviter (doc id = its own id, never changed by it afterwards);
    // the inviter reads the notes addressed to it and may only flip 'claimed'
    match /refs/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.to is string && request.resource.data.to != uid
        && request.resource.data.claimed == false;
      allow read: if request.auth != null && (request.auth.uid == uid || resource.data.to == request.auth.uid || owner());
      allow update: if request.auth != null && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']);
    }
    // Endless Tower ranking, one table per week: tower/{week}/s/{player}. A week runs Monday 00:00 to Sunday 23:59 Bangkok time (UTC+7).
    // A player writes only their own line, only into the week the SERVER clock is in (so a finished week is frozen without anyone closing it),
    // the floor may only go up, and 'at' must be the server time of that write (it breaks ties: who got there first).
    // week number w starts at w x 7 days + 4 days - 7 hours after 1 Jan 1970 UTC (the first Monday 00:00 Bangkok was 5 Jan 1970)
    function towerNow(week) {
      let start = int(week) * 604800000 + 320400000;
      return request.time.toMillis() >= start && request.time.toMillis() < start + 604800000;
    }
    match /tower/{week}/s/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && towerNow(week)
        && request.resource.data.f is int && request.resource.data.f >= 1 && request.resource.data.f <= 9999
        && request.resource.data.at == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && towerNow(week)
        && request.resource.data.f is int && request.resource.data.f > resource.data.f && request.resource.data.f <= 9999
        && request.resource.data.at == request.time;
      allow delete: if owner();
    }
    // b173 first players to clear stage 1100 (Glacius Rex): one document, n goes up by exactly one up to 3 and the caller appends only their own uid and name
    match /firsts/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && id == 's1100'
        && request.resource.data.n == 1 && request.resource.data.u == [request.auth.uid]
        && request.resource.data.nm is list && request.resource.data.nm.size() == 1;
      allow update: if request.auth != null && id == 's1100'
        && resource.data.n < 3 && !(request.auth.uid in resource.data.u)
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data.u == resource.data.u.concat([request.auth.uid])
        && request.resource.data.nm is list && request.resource.data.nm.size() == request.resource.data.u.size()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n','u','nm']);
      allow delete: if owner();
    }
    // live game settings (maintenance, notice, top-up hours, end of CBT, suspended accounts): everyone reads, only the owner writes
    match /config/{id} {
      allow read: if true;
      allow write: if owner();
    }
    // slip ledger written by the top-up Worker: only the owner reads it
    match /slips/{id} {
      allow read: if owner();
    }
    // what the owner did on the admin page
    match /adminlog/{id} {
      allow read, write: if owner();
    }
  }
}
